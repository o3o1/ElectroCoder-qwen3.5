@echo off
echo 验证RMS计算算法
echo.

echo 测试用例 a (正弦波半个周期): [0.0, 0.707, 1.0, 0.707, 0.0]
echo 计算: sqrt((0^2 + 0.707^2 + 1^2 + 0.707^2 + 0^2)/5)
echo = sqrt((0 + 0.499849 + 1 + 0.499849 + 0)/5)
echo = sqrt(1.999698/5) = sqrt(0.3999396) = 0.6324
echo.

echo 测试用例 b (直流序列): [2.5, 2.5, 2.5, 2.5]
echo 计算: sqrt((2.5^2 + 2.5^2 + 2.5^2 + 2.5^2)/4)
echo = sqrt((6.25 + 6.25 + 6.25 + 6.25)/4)
echo = sqrt(25/4) = sqrt(6.25) = 2.5000
echo.

echo 测试用例 c (包含负值的交流序列): [-1.0, 0.0, 1.0, 0.0]
echo 计算: sqrt(((-1)^2 + 0^2 + 1^2 + 0^2)/4)
echo = sqrt((1 + 0 + 1 + 0)/4)
echo = sqrt(2/4) = sqrt(0.5) = 0.7071
echo.

echo 验证通过